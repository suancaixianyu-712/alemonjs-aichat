{
  "title": "IA聊天插件",
  "desc": "",
  "name": "aichat",
  "version": "v1.0.9",
  "by": "AlemonJS",
  "list": [
    {
      "group": {
        "title": "配置操作",
        "items": [
          {
            "cmd": "/添加ai",
            "desc": "添加新的AI聊天配置。"
          },
          {
            "cmd": "/删除ai [名称]",
            "desc": "删除已有的AI聊天配置。"
          },
          {
            "cmd": "/ai配置",
            "desc": "查看当前的ai配置"
          },
          {
            "cmd": "/ai列表",
            "desc": "查看当前可用的ai配置列表"
          },
          {
            "cmd": "/切换ai [名称]",
            "desc": "切换到指定名称的ai配置。"
          }
        ]
      }
    },
    {
      "group": {
        "title": "提示词操作",
        "items": [
          {
            "cmd": "/添加提示词 [名称] [内容]",
            "desc": "添加新的AI聊天配置。"
          },
          {
            "cmd": "/删除提示词 [名称]",
            "desc": "删除已有的AI聊天配置。"
          },
          {
            "cmd": "/提示词列表",
            "desc": "查看当前可用的提示词列表"
          },
          {
            "cmd": "/查看提示词",
            "desc": "查看当前的提示词设置"
          },
          {
            "cmd": "/清空提示词",
            "desc": "清空当前的提示词设置"
          }
        ]
      }
    },
    {
      "group": {
        "title": "聊天",
        "items": [
          {
            "cmd": "/[开启|关闭]聊天",
            "desc": "开启或关闭AI聊天功能。"
          },
          {
            "cmd": "/[开启|关闭]好感度",
            "desc": "开启或关闭好感度功能。"
          },
          {
            "cmd": "/[开启|关闭]语音回复",
            "desc": "开启或关闭语音回复功能。"
          },
          {
            "cmd": "/[开启|关闭]MCP工具",
            "desc": "开启或关闭MCP工具功能。部分AI模型可能不支持该功能。"
          },
          {
            "cmd": "/好感度",
            "desc": "查看当前好感度状态。"
          },
          {
            "cmd": "/清空好感度",
            "desc": "清空当前用户的好感度数据。"
          },
          {
            "cmd": "/清空对话",
            "desc": "清空当前页面的对话记录。"
          }
        ]
      }
    },
    {
      "group": {
        "title": "管理员设置",
        "items": [
          {
            "cmd": "/清空所有对话",
            "desc": "清空所有用户的对话记录。"
          },
          {
            "cmd": "/清空所有好感度",
            "desc": "清空所有用户的好感度数据。"
          }
        ]
      }
    }
  ]
}
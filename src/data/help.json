{
  "title": "IA聊天插件",
  "desc": "一个基于AI的聊天插件，支持多种AI模型和丰富的功能配置，适用于各种聊天场景。",
  "name": "alemonjs-aichat",
  "version": "v1.0.32",
  "by": "AlemonJS",
  "list": [
    {
      "group": {
        "title": "配置操作",
        "desc": "在新的聊天窗口中需要先配置ai才能使用",
        "items": [
          {
            "cmd": "/[开启|关闭]聊天",
            "desc": "自动配置一个ai并开启聊天功能,或者关闭聊天功能。"
          },
          {
            "cmd": "/添加ai",
            "desc": "添加新的AI聊天配置。"
          },
          {
            "cmd": "/删除ai [名称]",
            "desc": "删除已有的AI聊天配置。"
          },
          {
            "cmd": "/ai配置",
            "desc": "查看当前的ai配置"
          },
          {
            "cmd": "/ai列表",
            "desc": "查看当前可用的ai配置列表"
          },
          {
            "cmd": "/切换ai [名称]",
            "desc": "切换到指定名称的ai配置。"
          },
          {
            "cmd": "/修改 [AI名称] 模型 [模型名称]",
            "desc": "修改指定AI配置的模型。"
          }
        ]
      }
    },
    {
      "group": {
        "title": "提示词操作",
        "desc": "提示词功能可以让你为AI聊天配置添加特定的提示词，以引导AI的回复风格和内容。",
        "items": [
          {
            "cmd": "/添加提示词 [名称] [内容]",
            "desc": "添加新的提示词配置。"
          },
          {
            "cmd": "/删除提示词 [名称]",
            "desc": "删除已有的提示词配置。"
          },
          {
            "cmd": "/提示词列表",
            "desc": "查看当前可用的提示词列表"
          },
          {
            "cmd": "/查看提示词",
            "desc": "查看当前的提示词设置"
          },
          {
            "cmd": "/清空提示词",
            "desc": "清空当前的提示词设置"
          }
        ]
      }
    },
    {
      "group": {
        "title": "聊天",
        "desc": "以下功能的可用性取决于所使用的AI模型是否支持相关工具。",
        "items": [
          {
            "cmd": "/[开启|关闭]聊天",
            "desc": "开启或关闭AI聊天功能。"
          },
          {
            "cmd": "/[开启|关闭]主动搭话",
            "desc": "开启或关闭主动搭话功能。"
          },
          {
            "cmd": "/[开启|关闭]仅艾特触发",
            "desc": "开启或关闭仅艾特触发功能, 避免群内有多个AI时互相干扰。"
          },
          {
            "cmd": "/添加正则规则 [表达式]",
            "desc": "添加正则触发规则，匹配的消息将自动触发AI回复，无需艾特。"
          },
          {
            "cmd": "/删除正则规则 [序号或内容]",
            "desc": "删除指定的正则触发规则。"
          },
          {
            "cmd": "/正则规则列表",
            "desc": "查看当前所有正则触发规则。"
          },
          {
            "cmd": "/清空正则规则",
            "desc": "清空所有正则触发规则。"
          },
          {
            "cmd": "/切换群容器",
            "desc": "切换 exec 指令指向当前群的 Docker 容器。"
          },
          {
            "cmd": "/切换用户容器",
            "desc": "切换 exec 指令指向自己的 Docker 容器。"
          },
          {
            "cmd": "/切换系统环境",
            "desc": "[仅超级管理员私聊]切换 exec 指令指向宿主机。"
          },
          {
            "cmd": "/[开启|关闭]好感度",
            "desc": "开启或关闭好感度功能。"
          },
          {
            "cmd": "/[开启|关闭]语音回复",
            "desc": "[限QQ平台][需部署gpt-sovits]开启或关闭语音回复功能。"
          },
          {
            "cmd": "/[开启|关闭]复杂回复",
            "desc": "当模型不支持json输出时关闭该功能可以让AI以纯文本形式回复,关闭后无法识别图片 使用工具 好感度等功能,适合本地部署的ai"
          },
          {
            "cmd": "/好感度",
            "desc": "查看当前好感度状态。"
          },
          {
            "cmd": "/清空好感度",
            "desc": "清空当前用户的好感度数据。"
          },
          {
            "cmd": "/清空对话",
            "desc": "清空当前页面的对话记录。"
          }
        ]
      }
    },
    {
      "group": {
        "title": "AI功能",
        "desc": "这里的功能基于特定ai制作，使用前请确认你的ai是否支持相关功能，部分功能需要在配置中开启工具开关才可用",
        "items": [
          {
            "cmd": "/ps [提示词]",
            "desc": "[需配置grok模型]使用ai修图功能对图片进行处理。提示词可以包含对图片的描述和修改要求。"
          },
          {
            "cmd": "/画图 [提示词]",
            "desc": "使用ai画图功能根据提示词生成图片。提示词可以包含对图片的描述和要求。"
          },
          {
            "cmd": "/[开启|关闭]画图提示词优化",
            "desc": "[需配置任意模型]开启后画图提示词会自动优化以获得更好的画图效果，适合不擅长编写提示词的用户使用。"
          },
          {
            "cmd": "/生成视频 [提示词]",
            "desc": "[需配置grok模型]使用ai生成视频功能根据提示词生成视频。提示词可以包含对视频的描述和要求。"
          },
          {
            "cmd": "/[角色名]说 [内容]",
            "desc": "[需部署gpt-sovits]让指定角色说出内容。角色名需要在提示词中定义，内容可以是任何文本。"
          },
          {
            "cmd": "/安装语音 [角色名]",
            "desc": "[需部署gpt-sovits]安装指定角色的语音, 以米游的角色为主"
          }
        ]
      }
    },
    {
      "group": {
        "title": "工具操作",
        "desc": "这里的功能用于控制工具的使用, 部分功能需要管理员权限",
        "items": [
          {
            "cmd": "/[开启|关闭]工具",
            "desc": "开启或关闭工具功能。部分AI模型可能不支持该功能。"
          },
          {
            "cmd": "/[开启|关闭]工具[工具名]",
            "desc": "开启或关闭指定工具功能,部分工具可能会有安全风险,请谨慎使用。"
          },
          {
            "cmd": "/工具列表",
            "desc": "查看当前所有工具的状态。"
          },
          {
            "cmd": "/[开启|关闭]工具提示",
            "desc": "开启或关闭工具调用提示功能。开启后每次调用工具都会有提示消息。"
          },
          {
            "cmd": "/[开启|关闭]工具提示撤回",
            "desc": "开启或关闭工具调用提示撤回功能。开启后工具调用的提示消息会在一段时间后自动撤回。"
          },
          {
            "cmd": "/[开启|关闭]工具提示详情",
            "desc": "开启或关闭工具调用提示详情功能。开启后工具调用的提示消息会包含更多的详情信息。"
          }
        ]
      }
    },
    {
      "group": {
        "title": "管理员设置",
        "desc": "以下功能仅管理员可用，用于管理所有用户的对话记录和好感度数据。",
        "items": [
          {
            "cmd": "/清空所有对话",
            "desc": "清空所有用户的对话记录。"
          },
          {
            "cmd": "/清空所有好感度",
            "desc": "清空所有用户的好感度数据。"
          },
          {
            "cmd": "/关闭所有聊天",
            "desc": "关闭所有用户的聊天功能。"
          },
          {
            "cmd": "/[可以|不可以]涩涩",
            "desc": "开启或关闭涩涩功能, 开启后AI可能会生成一些R18的内容, 请谨慎使用。"
          }
        ]
      }
    }
  ]
}
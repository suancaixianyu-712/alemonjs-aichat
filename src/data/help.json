{
  "title": "AI 聊天插件",
  "desc": "先选择功能分类，再查看具体指令。",
  "name": "alemonjs-aichat",
  "version": "v1.0.96",
  "by": "AlemonJS",
  "list": [
    {
      "group": {
        "id": "chat",
        "key": "聊天",
        "title": "日常聊天",
        "aliases": [
          "日常",
          "聊天功能",
          "好感度"
        ],
        "desc": "聊天开关、触发方式、对话记录和好感度。",
        "items": [
          {
            "cmd": "/[开启|关闭]聊天",
            "desc": "开启时自动选择可用 AI；关闭时停止当前会话的 AI 聊天。",
            "common": true
          },
          {
            "cmd": "/清空对话",
            "desc": "清空当前页面的对话记录。",
            "common": true
          },
          {
            "cmd": "/删除对话",
            "desc": "直接删除当前对话记录，不做归档总结。"
          },
          {
            "cmd": "/终止任务",
            "desc": "停止当前这轮 AI 回复、后续工具调用及正在运行的 OpenCode/Codex 任务。"
          },
          {
            "cmd": "/[开启|关闭]仅艾特触发",
            "desc": "开启或关闭仅艾特触发功能, 避免群内有多个AI时互相干扰。"
          },
          {
            "cmd": "/[开启|关闭]主动搭话",
            "desc": "开启或关闭主动搭话功能。"
          },
          {
            "cmd": "/添加正则规则 [表达式]",
            "desc": "添加正则触发规则，匹配的消息将自动触发AI回复，无需艾特。"
          },
          {
            "cmd": "/删除正则规则 [序号或内容]",
            "desc": "删除指定的正则触发规则。"
          },
          {
            "cmd": "/正则规则列表",
            "desc": "查看当前所有正则触发规则。"
          },
          {
            "cmd": "/清空正则规则",
            "desc": "清空所有正则触发规则。"
          },
          {
            "cmd": "/[开启|关闭]好感度",
            "desc": "开启或关闭好感度功能。"
          },
          {
            "cmd": "/好感度",
            "desc": "查看当前好感度状态。"
          },
          {
            "cmd": "/清空好感度",
            "desc": "清空当前用户的好感度数据。"
          },
          {
            "cmd": "/[开启|关闭]限制[数量]",
            "desc": "开启聊天频率限制；每分钟默认 2 条，主人不受限制。例：/开启限制5。"
          },
          {
            "cmd": "/撤回",
            "desc": "引用一条消息发送撤回指令，自动撤回被引用的消息。"
          }
        ]
      }
    },
    {
      "group": {
        "id": "config",
        "key": "配置",
        "title": "AI 配置",
        "aliases": [
          "ai",
          "AI配置",
          "配置操作",
          "模型",
          "识图",
          "代理"
        ],
        "desc": "选择模型、接口协议、识图和回复设置。",
        "items": [
          {
            "cmd": "#切换AI [厂商/模型]",
            "desc": "按厂商选择模型，或直接切换指定模型。",
            "common": true
          },
          {
            "cmd": "/ai列表",
            "desc": "查看当前可用的ai配置列表"
          },
          {
            "cmd": "/ai配置",
            "desc": "查看当前的ai配置",
            "common": true
          },
          {
            "cmd": "#添加ai",
            "desc": "添加新的AI聊天配置。"
          },
          {
            "cmd": "/删除ai [名称]",
            "desc": "删除已有的AI聊天配置。"
          },
          {
            "cmd": "#切换接口 [capi|rapi]",
            "desc": "查看或切换当前AI配置使用的接口协议。"
          },
          {
            "cmd": "/修改 [AI名称] 模型 [模型名称]",
            "desc": "修改指定AI配置的模型。"
          },
          {
            "cmd": "/设置识图ai [名称]",
            "desc": "配置识图专用 AI，供无法看图的主模型使用。查看：/设置识图；关闭：/设置识图 关闭。"
          },
          {
            "cmd": "/设置AI上下文长度 [512k|1m]",
            "desc": "设置 CAPI 模式自动压缩上下文的长度，默认 512k。"
          },
          {
            "cmd": "/[开启|关闭]复杂回复",
            "desc": "控制结构化回复；关闭后改用纯文本，并停用识图、工具和好感度等能力。"
          },
          {
            "cmd": "/[开启|关闭]代理",
            "desc": "[仅管理员]为当前 AI 配置开启代理或直连，代理地址使用 aichat.httpProxy。"
          },
          {
            "cmd": "#锁定AI [序号...]",
            "desc": "主人批量锁定AI配置，普通用户将无法切换或继续使用。"
          },
          {
            "cmd": "#解锁AI [序号...]",
            "desc": "主人按AI列表序号批量解除锁定。"
          },
          {
            "cmd": "/[开启|关闭]深度思考",
            "desc": "开启（medium）或关闭深度思考。"
          },
          {
            "cmd": "#模型列表",
            "desc": "[仅主人]拉取当前会话所选 AI 配置的厂商模型列表。"
          },
          {
            "cmd": "#思考深度 [档位]",
            "desc": "查询当前深度思考档位；主人可设 none/minimal/low/medium/high/xhigh/max。"
          }
        ]
      }
    },
    {
      "group": {
        "id": "prompts",
        "key": "提示词",
        "title": "提示词",
        "aliases": [
          "提示词操作",
          "人设",
          "prompt"
        ],
        "desc": "添加、切换和查看 AI 的角色与回复风格。",
        "items": [
          {
            "cmd": "/提示词列表",
            "desc": "查看当前可用的提示词列表"
          },
          {
            "cmd": "/切换提示词 [名称]",
            "desc": "为当前会话选择提示词；不填名称时查看可选列表。"
          },
          {
            "cmd": "/查看提示词",
            "desc": "查看当前的提示词设置"
          },
          {
            "cmd": "/添加提示词 [名称] [内容]",
            "desc": "添加新的提示词配置。"
          },
          {
            "cmd": "/删除提示词 [名称]",
            "desc": "删除已有的提示词配置。"
          },
          {
            "cmd": "/清空提示词",
            "desc": "清空当前的提示词设置"
          }
        ]
      }
    },
    {
      "group": {
        "id": "images",
        "key": "画图",
        "title": "绘图与视频",
        "aliases": [
          "绘图",
          "绘图视频",
          "绘图与视频",
          "图像",
          "图片",
          "视频",
          "AI功能",
          "grok",
          "gpt"
        ],
        "desc": "生成或编辑图片、优化提示词和生成视频。",
        "items": [
          {
            "cmd": "/画图 [提示词]",
            "desc": "使用ai画图功能根据提示词生成图片。提示词可以包含对图片的描述和要求。"
          },
          {
            "cmd": "/grok画图 [提示词] [可选图片]",
            "desc": "使用已配置的 Grok 画图模型生成或编辑图片。"
          },
          {
            "cmd": "/gpt画图 [提示词] [可选图片]",
            "desc": "使用 GPT 图像模型生成图片；携带或回复图片时，可按提示词编辑该图片。"
          },
          {
            "cmd": "/生成视频 [提示词]",
            "desc": "[需配置grok模型]使用ai生成视频功能根据提示词生成视频。提示词可以包含对视频的描述和要求。"
          },
          {
            "cmd": "/grok画图配置 [AI配置编号] [画图模型]",
            "desc": "选择已有 AI 配置，复用其 API 地址和密钥，并指定 Grok 画图模型。"
          },
          {
            "cmd": "/gpt画图配置 [AI配置编号] [画图模型]",
            "desc": "选择已有 AI 配置，复用其 API 地址和密钥，并指定画图模型。"
          },
          {
            "cmd": "/[开启|关闭]画图提示词优化",
            "desc": "[需配置任意模型]开启后画图提示词会自动优化以获得更好的画图效果，适合不擅长编写提示词的用户使用。"
          },
          {
            "cmd": "/转图片",
            "desc": "回复一条表情消息后使用，将表情下载并重新以图片形式发送。"
          }
        ]
      }
    },

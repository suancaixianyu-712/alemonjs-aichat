{
  "name": "alemonjs-aichat-quick-start",
  "version": "1.0.0",
  "description": "AlemonJS Aichat quick-start workspace",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22",
    "yarn": "^1.22.0"
  },
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "update:aichat": "node scripts/update-aichat.mjs",
    "start": "node index.js",
    "start:pm2": "pm2 startOrRestart pm2.config.cjs",
    "stop": "pm2 stop pm2.config.cjs",
    "logs": "pm2 logs alemon-aichat"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@alemonjs/db": "^0.0.17",
    "@alemonjs/onebot": "^2.1.16",
    "alemonjs": "2.1.92",
    "pm2": "^5"
  }
}

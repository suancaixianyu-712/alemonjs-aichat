{
  "name": "alemonjs-aichat",
  "version": "1.0.67",
  "description": "alemonjs-aichat",
  "author": "suancaixianyu",
  "license": "MIT",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "dev": "npx lvy dev",
    "build": "npx lvy build",
    "review": "npx alemonc start",
    "view": "npx lvy dev --view",
    "img": "tsx watch --import lvyjs/register app.ts --jsxp",
    "start": "npx pm2 startOrRestart pm2.config.cjs",
    "stop": "npx pm2 stop pm2.config.cjs",
    "delete": "npx pm2 delete pm2.config.cjs",
    "update": "npm publish"
  },
  "devDependencies": {
    "@alemonjs/bubble": "^2.1.10",
    "@alemonjs/db": "^0.0.16",
    "@alemonjs/onebot": "^2.1.14",
    "@types/node": "^22.19.17",
    "alemonjs": "2.1.92",
    "cssnano": "^7",
    "lvyjs": "^0.2.25",
    "pm2": "^5",
    "tailwindcss": "3"
  },
  "export": {
    ".": "./lib/index.js",
    "./package": "./package.json",
    "./desktop": "./lib/desktop.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package": "./package.json",
    "./desktop": "./lib/desktop.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "alemonjs": {
    "config": [
      {
        "description": "内置 AI 配置",
        "name": "ai",
        "required": false,
        "type": "object",
        "config": [
          {
            "description": "AI 名称",
            "name": "name",
            "required": true,
            "type": "string"
          },
          {
            "description": "接口地址",
            "name": "host",
            "required": true,
            "type": "string"
          },
          {
            "description": "API Key",
            "name": "key",
            "required": true,
            "type": "string"
          },
          {
            "description": "模型名称",
            "name": "model",
            "required": true,
            "type": "string"
          }
        ]
      },
      {
        "description": "xAI 图片生成服务的代理地址",
        "name": "xaiImgProxy",
        "required": false,
        "type": "string"
      },
      {
        "description": "TTS 语音服务",
        "name": "ttsServer",
        "required": false,
        "type": "object",
        "config": [
          {
            "description": "TTS 服务地址",
            "name": "host",
            "required": false,
            "type": "string"
          }
        ]
      },
      {
        "description": "百度内容审核",
        "name": "baidu",
        "required": false,
        "type": "object",
        "config": [
          {
            "description": "百度 API Key",
            "name": "ak",
            "required": false,
            "type": "string"
          },
          {
            "description": "百度 Secret Key",
            "name": "sk",
            "required": false,
            "type": "string"
          }
        ]
      },
      {
        "description": "额外技能目录",
        "name": "skills_dir",
        "required": false,
        "type": "array<string>",
        "default": [
          "./skills"
        ]
      },
      {
        "description": "OpenCode 工具服务",
        "name": "opencodeServer",
        "required": false,
        "type": "object",
        "config": [
          {
            "description": "服务端口",
            "name": "port",
            "required": false,
            "type": "number",
            "default": 4096
          },
          {
            "description": "监听地址",
            "name": "hostname",
            "required": false,
            "type": "string",
            "default": "127.0.0.1"
          },
          {
            "description": "OpenCode 可执行文件路径",
            "name": "binary",
            "required": false,
            "type": "string"
          }
        ]
      },
      {
        "description": "Redis 连接",
        "name": "redis",
        "required": false,
        "type": "object",
        "config": [
          {
            "description": "Redis 主机或 IP",
            "name": "host",
            "required": false,
            "type": "string"
          },
          {
            "description": "Redis 端口",
            "name": "port",
            "required": false,
            "type": "number",
            "default": 6379
          },
          {
            "description": "Redis 密码",
            "name": "password",
            "required": false,
            "type": "string"
          },
          {
            "description": "Redis 用户名",
            "name": "user",
            "required": false,
            "type": "string"
          }
        ]
      }
    ]
  },
  "dependencies": {
    "@ai-sdk/xai": "^3.0.60",
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "ai": "^6.0.105",
    "jsxp": "^1.4.0",
    "koa": "^3.2.0",
    "koa-router": "^14.0.0",
    "koa-send": "^5.0.1",
    "koa-static": "^5.0.0",
    "mime-types": "^3.0.2",
    "node-fetch": "^3.3.2",
    "openai": "^6.34.0",
    "playwright-core": "^1.59.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  }
}

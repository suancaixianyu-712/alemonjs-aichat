{
  "name": "alemonjs-aichat",
  "version": "1.0.66",
  "description": "alemonjs-aichat",
  "author": "suancaixianyu",
  "license": "MIT",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "dev": "npx lvy dev",
    "build": "npx lvy build",
    "review": "npx alemonc start",
    "view": "npx lvy dev --view",
    "img": "tsx watch --import lvyjs/register app.ts --jsxp",
    "start": "npx pm2 startOrRestart pm2.config.cjs",
    "stop": "npx pm2 stop pm2.config.cjs",
    "delete": "npx pm2 delete pm2.config.cjs",
    "update": "npm publish"
  },
  "devDependencies": {
    "@alemonjs/bubble": "^2.1.10",
    "@alemonjs/db": "^0.0.16",
    "@alemonjs/onebot": "^2.1.14",
    "@types/node": "^22.19.17",
    "alemonjs": "2.1.92",
    "cssnano": "^7",
    "lvyjs": "^0.2.25",
    "pm2": "^5",
    "tailwindcss": "3"
  },
  "export": {
    ".": "./lib/index.js",
    "./package": "./package.json",
    "./desktop": "./lib/desktop.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package": "./package.json",
    "./desktop": "./lib/desktop.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "alemonjs": {
    "config-source": {
      "official": "https://alemonjs.com"
    },
    "config": [
      {
        "name": "runtime_mode",
        "type": "string",
        "required": false,
        "description": "运行时模式：local（插件托管，默认）、external（外部进程托管）",
        "default": "local"
      },
      {
        "name": "transport",
        "type": "string",
        "required": false,
        "description": "消息桥接传输方式：websocket（默认）或 http（兼容网关服务）",
        "default": "websocket"
      },
      {
        "name": "gscore_url",
        "type": "string",
        "required": false,
        "description": "GsCore HTTP 地址，用于 external 运行时连接外部托管网关",
        "default": ""
      }
    ],
    "desktop": {
      "logo": "./lib/logo.png"
    }
  },
  "dependencies": {
    "@ai-sdk/xai": "^3.0.60",
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "ai": "^6.0.105",
    "jsxp": "^1.4.0",
    "koa": "^3.2.0",
    "koa-router": "^14.0.0",
    "koa-send": "^5.0.1",
    "koa-static": "^5.0.0",
    "mime-types": "^3.0.2",
    "node-fetch": "^3.3.2",
    "openai": "^6.34.0",
    "playwright-core": "^1.59.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  }
}
